<configuration debug="false">
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>${testLogLevel:-INFO}</level>
    </filter>
    <encoder>
      <pattern>[%level] %logger{45}:%X{line} | %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Log file for the fixture files update check -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>target/fixtures-update.log</file>
    <append>false</append> <!-- Clean slate for every run -->
    <encoder>
      <pattern>[%level] %logger{45}:%line -- %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.netty" level="ERROR" additivity="false">
    <appender-ref ref="STDOUT" />
  </logger>

  <logger name="info.freelibrary.util" level="ERROR" additivity="false">
    <appender-ref ref="STDOUT" />
  </logger>

  <logger name="info.freelibrary.json" level="WARN" additivity="false">
    <appender-ref ref="STDOUT" />
  </logger>

  <!-- If the below is courser than WARN, the fixtures-update.log will not contain entries -->
  <logger name="info.freelibrary.iiif.presentation.v3.utils.CookbookUtils" level="WARN" additivity="false">
    <appender-ref ref="FILE"/>
  </logger>

  <root level="${testLogLevel:-INFO}">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
